<?xml version="1.0" encoding="utf-8"?>
<!--
  使用前警告：必须**下拉看完**才允许点「同意」/「拒绝」。
  同意 → 正常使用；拒绝 → 应用自动退出。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="4dp">

    <!--
      高度必须是确定的：之前写成 layout_height="0dp" + layout_weight="0"，
      结果滚动区域高度为 0，条款正文完全看不见（只有提示语和按钮）。
      这里固定 340dp：任何屏幕上都能看到正文，且一定能滚动到底部。
    -->
    <ScrollView
        android:id="@+id/svBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/tvBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_primary"
            android:textIsSelectable="true"
            android:textSize="13sp" />
    </ScrollView>

    <TextView
        android:id="@+id/tvScrollHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="↓ 请下拉阅读到底部，才能选择「同意」或「拒绝」"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />
</LinearLayout>
