<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="216dp">

    <ImageView
        android:id="@+id/ivBanner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_balloon" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/banner_shade" />

    <View
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:background="@drawable/banner_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnPrevMonth"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="上个月"
                android:padding="3dp"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/on_primary" />

            <TextView
                android:id="@+id/tvMonthTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:text="2026-10"
                android:textColor="@color/on_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnNextMonth"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="下个月"
                android:padding="3dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/on_primary" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnGoSearch"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="搜索账单"
                android:padding="5dp"
                android:src="@drawable/ic_search"
                app:tint="@color/on_primary" />

            <ImageView
                android:id="@+id/btnGoStats"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="统计"
                android:padding="5dp"
                android:src="@drawable/ic_nav_chart"
                app:tint="@color/on_primary" />

            <ImageView
                android:id="@+id/btnGoSettings"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="设置"
                android:padding="5dp"
                android:src="@drawable/ic_gear"
                app:tint="@color/on_primary" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="月支出"
            android:textColor="#D9FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvMonthExpense"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="0.00"
            android:textColor="@color/on_primary"
            android:textSize="34sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMonthIncome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="月收入 0.00"
                android:textColor="#E6FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvMonthBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:text="本月结余 0.00"
                android:textColor="#E6FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
